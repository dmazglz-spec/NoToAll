<UserControl x:Class="NoToAll.Views.ReportsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="16" Background="#25394c" Padding="18" Margin="18">
        <DataGrid AutoGenerateColumns="True" FontFamily="Consolas" FontSize="15" GridLinesVisibility="All"
                  MinHeight="350"
                  ColumnHeaderStyle="{StaticResource GameDataGridHeader}"
                  RowBackground="#2d415b" AlternatingRowBackground="#334a6a"
                  Foreground="White">
            <!-- Пример структуры таблиц, при интеграции заменить привязкой к данным -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="310"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</UserControl>