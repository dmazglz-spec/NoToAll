<Window x:Class="NoToAll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NoToAll.Views"
        Title="NoToAll - Game AccountApp" Height="650" Width="1100" Background="#1A2233">
    <DockPanel>
        <!-- Верхняя панель инструментов -->
        <views:Toolbar DockPanel.Dock="Top" />
        <!-- Центральное содержимое приложения -->
        <Grid>
            <!-- Правая выдвижная панель с меню -->
            <views:ReportsMenu x:Name="ReportsMenu" HorizontalAlignment="Right" VerticalAlignment="Stretch"/>
            <!-- Область для отчетов -->
            <views:ReportsPanel x:Name="ReportsPanel" Margin="0,0,240,0" />
        </Grid>
    </DockPanel>
</Window>